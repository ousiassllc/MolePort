{
  "name": "moleport-gui",
  "private": true,
  "description": "MolePort GUI frontend assets (HTMX + Tailwind + esbuild)",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs && tailwindcss -i internal/gui/web/static/src/css/app.css -o internal/gui/web/static/dist/css/app.css --minify",
    "watch": "node esbuild.config.mjs --watch & tailwindcss -i internal/gui/web/static/src/css/app.css -o internal/gui/web/static/dist/css/app.css --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "htmx.org": "^2.0.11"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
