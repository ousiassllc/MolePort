package organisms

import (
	"github.com/ousiassllc/moleport/internal/gui/service"
	"github.com/ousiassllc/moleport/internal/gui/web/view/atoms"
	"github.com/ousiassllc/moleport/internal/gui/web/view/molecules"
	"github.com/ousiassllc/moleport/internal/i18n"
)

const (
	typeLocal   = "local"
	typeRemote  = "remote"
	typeDynamic = "dynamic"
)

func hostOptions(hosts []string) []atoms.SelectOption {
	opts := make([]atoms.SelectOption, len(hosts))
	for i, h := range hosts {
		opts[i] = atoms.SelectOption{Value: h, Label: h}
	}
	return opts
}

func typeOptions() []atoms.SelectOption {
	return []atoms.SelectOption{
		{Value: typeLocal, Label: i18n.T("gui.forward.form.type_local")},
		{Value: typeRemote, Label: i18n.T("gui.forward.form.type_remote")},
		{Value: typeDynamic, Label: i18n.T("gui.forward.form.type_dynamic")},
	}
}

// typeSelectAttrs は種別の選択で項目を出し分けるための再取得属性。
// フォームの現在値を GET クエリに含めて /fragments/forward-form を取り直し、モーダル内容を差し替える。
func typeSelectAttrs() templ.Attributes {
	return templ.Attributes{
		"hx-get":     "/fragments/forward-form",
		"hx-trigger": "change",
		"hx-include": "closest form",
		"hx-target":  "#modal-root",
		"hx-swap":    "innerHTML",
	}
}

// ForwardForm は転送追加フォーム（モーダル内容）。種別（local / remote / dynamic）で項目を出し分ける:
// dynamic にはリモート項目を描画せず、remote のときのみバインドアドレスを描画する。
// errs は検証エラー（422 の再描画）。入力値は in のまま保持する。
templ ForwardForm(in service.ForwardFormInput, errs service.FormErrors, hosts []string) {
	<dialog id="forward-form-dialog" class="mp-modal" aria-labelledby="forward-form-title">
		<form
			id="forward-form"
			hx-post="/actions/forwards"
			hx-target="#forwards-panel"
			hx-swap="innerHTML"
			hx-disabled-elt="find button[type=submit]"
		>
			<h2 id="forward-form-title" class="mp-modal-title">{ i18n.T("gui.forward.form.title") }</h2>
			if errs["_form"] != "" {
				<p class="mp-field-error" role="alert">{ errs["_form"] }</p>
			}
			@molecules.FormField(molecules.FormFieldProps{
				Label: i18n.T("gui.forward.form.host"),
				Name:  "host",
				Error: errs["host"],
				Input: atoms.Select(atoms.SelectProps{Name: "host", Options: hostOptions(hosts), Selected: in.Host, Invalid: errs["host"] != ""}),
			})
			@molecules.FormField(molecules.FormFieldProps{
				Label: i18n.T("gui.forward.form.type"),
				Name:  "type",
				Error: errs["type"],
				Input: atoms.Select(atoms.SelectProps{Name: "type", Options: typeOptions(), Selected: in.Type, Invalid: errs["type"] != "", Attrs: typeSelectAttrs()}),
			})
			@molecules.FormField(molecules.FormFieldProps{
				Label: i18n.T("gui.forward.form.name"),
				Name:  "name",
				Error: errs["name"],
				Input: atoms.TextInput(atoms.TextInputProps{Name: "name", Value: in.Name, Placeholder: i18n.T("gui.forward.form.name_placeholder"), Invalid: errs["name"] != ""}),
			})
			@molecules.FormField(molecules.FormFieldProps{
				Label: i18n.T("gui.forward.form.local_port"),
				Name:  "local_port",
				Error: errs["local_port"],
				Input: atoms.TextInput(atoms.TextInputProps{Name: "local_port", Value: in.LocalPort, Type: "number", Required: true, Autofocus: true, Invalid: errs["local_port"] != "", Attrs: templ.Attributes{"min": "1", "max": "65535"}}),
			})
			if in.Type != typeDynamic {
				@molecules.FormField(molecules.FormFieldProps{
					Label: i18n.T("gui.forward.form.remote_host"),
					Name:  "remote_host",
					Error: errs["remote_host"],
					Input: atoms.TextInput(atoms.TextInputProps{Name: "remote_host", Value: in.RemoteHost, Placeholder: "localhost", Invalid: errs["remote_host"] != ""}),
				})
				@molecules.FormField(molecules.FormFieldProps{
					Label: i18n.T("gui.forward.form.remote_port"),
					Name:  "remote_port",
					Error: errs["remote_port"],
					Input: atoms.TextInput(atoms.TextInputProps{Name: "remote_port", Value: in.RemotePort, Type: "number", Placeholder: i18n.T("gui.forward.form.remote_port_placeholder"), Invalid: errs["remote_port"] != "", Attrs: templ.Attributes{"min": "1", "max": "65535"}}),
				})
			}
			if in.Type == typeRemote {
				@molecules.FormField(molecules.FormFieldProps{
					Label: i18n.T("gui.forward.form.remote_bind_addr"),
					Name:  "remote_bind_addr",
					Error: errs["remote_bind_addr"],
					Input: atoms.TextInput(atoms.TextInputProps{Name: "remote_bind_addr", Value: in.RemoteBindAddr, Placeholder: "127.0.0.1", Invalid: errs["remote_bind_addr"] != ""}),
				})
			}
			@molecules.FormField(molecules.FormFieldProps{
				Label: i18n.T("gui.forward.form.auto_connect"),
				Name:  "auto_connect",
				Input: atoms.Checkbox("auto_connect", in.AutoConnect),
			})
			<div class="mp-modal-actions">
				<button type="button" class="mp-btn" data-variant="secondary" id="forward-form-cancel" data-close-modal>{ i18n.T("gui.forward.form.cancel") }</button>
				<button type="submit" class="mp-btn" data-variant="primary" id="forward-form-submit">{ i18n.T("gui.forward.form.submit") }</button>
			</div>
		</form>
	</dialog>
}
