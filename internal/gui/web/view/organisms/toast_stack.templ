package organisms

import "github.com/ousiassllc/moleport/internal/i18n"

// ToastStack はトーストの表示領域。OOB（hx-swap-oob="beforeend:#toast-stack"）で追記される。
// mp:toast / mp:all で /fragments/toasts を取り出す（キューの drain。応答は OOB のみのため hx-swap="none"）。
// data-error-message / data-dismiss-label は app.ts がサーバー無応答時の汎用エラートーストに使う
// ローカライズ済み文言。
templ ToastStack() {
	<div
		id="toast-stack"
		class="mp-toast-stack"
		aria-live="polite"
		hx-get="/fragments/toasts"
		hx-trigger="mp:toast from:body, mp:all from:body"
		hx-swap="none"
		data-error-message={ i18n.T("gui.error.generic") }
		data-dismiss-label={ i18n.T("gui.toast.dismiss") }
	></div>
}
