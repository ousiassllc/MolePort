package organisms

import (
	"github.com/ousiassllc/moleport/internal/core/guiconfig"
	"github.com/ousiassllc/moleport/internal/gui/service"
	"github.com/ousiassllc/moleport/internal/gui/web/view/atoms"
	"github.com/ousiassllc/moleport/internal/gui/web/view/molecules"
	"github.com/ousiassllc/moleport/internal/i18n"
)

// languageOptions は対応言語の選択肢。ラベルはその言語自体での表示名。
func languageOptions() []atoms.SelectOption {
	langs := i18n.SupportedLangs()
	opts := make([]atoms.SelectOption, len(langs))
	for i, l := range langs {
		opts[i] = atoms.SelectOption{Value: string(l.Code), Label: l.Label}
	}
	return opts
}

// SettingsForm は設定フォーム（モーダル内容、UC-34）。言語・テーマ（base / accent のスウォッチ）・アップデートチェック。
// スウォッチの選択は app.ts がプレビューとして即時反映し、キャンセル（閉じる）で元に戻す。
// 成功時は本文を差し替えない（hx-swap="none"。OOB トーストのみ）。422 はハンドラが #modal-root へ差し替える。
// 他の経路（トレイ等）で設定が変わったときは mp:settings で取り直す。
templ SettingsForm(v service.SettingsView, errs service.FormErrors) {
	<dialog
		id="settings-dialog"
		class="mp-modal"
		aria-labelledby="settings-title"
		hx-get="/fragments/settings"
		hx-trigger="mp:settings from:body"
		hx-target="#modal-root"
		hx-swap="innerHTML"
	>
		<form id="settings-form" hx-post="/actions/settings" hx-swap="none" hx-disabled-elt="find button[type=submit]">
			<h2 id="settings-title" class="mp-modal-title">{ i18n.T("gui.settings.title") }</h2>
			if errs["_form"] != "" {
				<p class="mp-field-error" role="alert">{ errs["_form"] }</p>
			}
			@molecules.FormField(molecules.FormFieldProps{
				Label: i18n.T("gui.settings.language"),
				Name:  "language",
				Error: errs["language"],
				Input: atoms.Select(atoms.SelectProps{Name: "language", Options: languageOptions(), Selected: v.Language, Invalid: errs["language"] != ""}),
			})
			<fieldset class="mp-field" id="settings-theme-base">
				<legend class="mp-field-label">{ i18n.T("gui.settings.theme_base") }</legend>
				<div class="mp-swatches">
					for _, b := range guiconfig.Bases() {
						@molecules.ThemeSwatch(molecules.ThemeSwatchProps{Name: "theme_base", Value: b, Label: i18n.T("gui.settings.base." + b), Checked: b == v.ThemeBase})
					}
				</div>
				if errs["theme_base"] != "" {
					<p class="mp-field-error" role="alert">{ errs["theme_base"] }</p>
				}
			</fieldset>
			<fieldset class="mp-field" id="settings-theme-accent">
				<legend class="mp-field-label">{ i18n.T("gui.settings.theme_accent") }</legend>
				<div class="mp-swatches">
					for _, a := range guiconfig.Accents() {
						@molecules.ThemeSwatch(molecules.ThemeSwatchProps{Name: "theme_accent", Value: a, Label: i18n.T("gui.settings.accent." + a), Checked: a == v.ThemeAccent})
					}
				</div>
				if errs["theme_accent"] != "" {
					<p class="mp-field-error" role="alert">{ errs["theme_accent"] }</p>
				}
			</fieldset>
			@molecules.FormField(molecules.FormFieldProps{
				Label: i18n.T("gui.settings.update_check"),
				Name:  "update_check_enabled",
				Input: atoms.Checkbox("update_check_enabled", v.UpdateCheckEnabled),
			})
			<div class="mp-modal-actions">
				<button type="button" class="mp-btn" data-variant="secondary" id="settings-cancel" data-close-modal>{ i18n.T("gui.settings.cancel") }</button>
				<button type="submit" class="mp-btn" data-variant="primary" id="settings-submit">{ i18n.T("gui.settings.submit") }</button>
			</div>
		</form>
	</dialog>
}
