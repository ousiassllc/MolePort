package organisms

import (
	"net/url"
	"strconv"

	"github.com/ousiassllc/moleport/internal/gui/service"
	"github.com/ousiassllc/moleport/internal/gui/web/view/molecules"
	"github.com/ousiassllc/moleport/internal/i18n"
)

// credentialLabel は password / passphrase の入力ラベル。core が渡したプロンプト文言があればそれを使う。
func credentialLabel(v service.CredentialView) string {
	if v.Prompt != "" {
		return v.Prompt
	}
	if v.Passphrase() {
		return i18n.T("gui.credential.passphrase")
	}
	return i18n.T("gui.credential.password")
}

// CredentialDialog は待機中の先頭のクレデンシャル要求を入力するダイアログ（UC-31）。
// password / passphrase は 1 入力、keyboard-interactive はプロンプト数だけ入力を描画する
// （Echo=false は type="password"）。値は POST ボディでのみ送る。
// キャンセル（Esc を含む）は /actions/credential/{id}/cancel。
templ CredentialDialog(v service.CredentialView) {
	<dialog id="credential-dialog" class="mp-modal" aria-labelledby="credential-title" data-request-id={ v.RequestID }>
		<form
			id="credential-form"
			hx-post={ "/actions/credential/" + url.PathEscape(v.RequestID) }
			hx-target="#credential-root"
			hx-swap="innerHTML"
			hx-disabled-elt="find button"
		>
			<h2 id="credential-title" class="mp-modal-title">{ i18n.T("gui.credential.title", map[string]any{"Host": v.Host}) }</h2>
			if v.Remaining > 0 {
				<p class="mp-row-sub">{ i18n.T("gui.credential.remaining") }: { strconv.Itoa(v.Remaining) }</p>
			}
			if v.KeyboardInteractive() {
				for i, p := range v.Prompts {
					@molecules.CredentialPrompt(molecules.CredentialPromptProps{Label: p.Label, Name: "answers[]", Echo: p.Echo, Autofocus: i == 0})
				}
			} else {
				@molecules.CredentialPrompt(molecules.CredentialPromptProps{Label: credentialLabel(v), Name: "value", Autofocus: true})
			}
			<div class="mp-modal-actions">
				<button
					type="button"
					class="mp-btn"
					data-variant="secondary"
					id="credential-cancel"
					data-credential-cancel
					hx-post={ "/actions/credential/" + url.PathEscape(v.RequestID) + "/cancel" }
					hx-target="#credential-root"
					hx-swap="innerHTML"
					hx-disabled-elt="this"
				>{ i18n.T("gui.credential.cancel") }</button>
				<button type="submit" class="mp-btn" data-variant="primary" id="credential-submit">{ i18n.T("gui.credential.submit") }</button>
			</div>
		</form>
	</dialog>
}
