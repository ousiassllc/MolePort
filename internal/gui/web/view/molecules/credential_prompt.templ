package molecules

// CredentialPromptProps は CredentialPrompt の引数。Echo が false の入力は type="password"。
type CredentialPromptProps struct {
	Label     string
	Name      string // "value"（password / passphrase）または "answers[]"（keyboard-interactive）
	Echo      bool
	Autofocus bool
}

// CredentialPrompt はクレデンシャルの入力 1 件（ラベル + 入力）。
// 複数並ぶ keyboard-interactive でも name は同じ "answers[]" のため id は FieldID(name) が重複する。
// ラベルは入力を内包して関連付け、id は付けない。
templ CredentialPrompt(p CredentialPromptProps) {
	<label class="mp-field">
		<span class="mp-field-label">{ p.Label }</span>
		<input
			class="mp-input"
			type={ promptType(p.Echo) }
			name={ p.Name }
			autocomplete="off"
			autofocus?={ p.Autofocus }
		/>
	</label>
}

func promptType(echo bool) string {
	if echo {
		return "text"
	}
	return "password"
}
