package atoms

// FieldID はフォームの項目名から入力要素の id を作る。ラベルの for がこの値を参照する。
func FieldID(name string) string { return "field-" + name }

// ErrorID はフォームの項目名から検証エラー表示（<p>）の id を作る。検証エラーのある入力要素は
// aria-describedby でこの値を参照し、スクリーンリーダーが入力欄とエラー文を結び付けられるようにする。
func ErrorID(name string) string { return FieldID(name) + "-error" }

// TextInputProps は TextInput の引数。Type が空なら "text"。Attrs には hx-* などの追加属性を渡す。
type TextInputProps struct {
	Name        string
	Value       string
	Placeholder string
	Type        string // "text"（既定）| "password" | "number" など
	Required    bool
	Invalid     bool
	Autofocus   bool
	Attrs       templ.Attributes
}

func inputType(t string) string {
	if t == "" {
		return "text"
	}
	return t
}

// TextInput は 1 行の入力欄。値の空欄は placeholder の表示になる（採用はサーバー側で行う）。
templ TextInput(p TextInputProps) {
	<input
		class="mp-input"
		type={ inputType(p.Type) }
		id={ FieldID(p.Name) }
		name={ p.Name }
		value={ p.Value }
		placeholder={ p.Placeholder }
		autocomplete="off"
		required?={ p.Required }
		autofocus?={ p.Autofocus }
		if p.Invalid {
			aria-invalid="true"
			aria-describedby={ ErrorID(p.Name) }
		}
		{ p.Attrs... }
	/>
}
